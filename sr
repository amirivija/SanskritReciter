#!/usr/bin/env bash
# Launcher: always use the project virtualenv (not system python3).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
PY="$ROOT/.venv/bin/python"

if [[ ! -x "$PY" ]]; then
  echo "error: project venv not found at $ROOT/.venv" >&2
  echo "Create it once:" >&2
  echo "  cd $ROOT" >&2
  echo "  /opt/homebrew/bin/python3.11 -m venv .venv" >&2
  echo "  source .venv/bin/activate" >&2
  echo "  pip install -r requirements.txt && pip install -e ." >&2
  echo "  # or: bash scripts/setup_local.sh" >&2
  exit 1
fi

export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"
exec "$PY" -m sanskrit_reciter "$@"
