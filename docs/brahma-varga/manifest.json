  "verses": [
    {
      "id": "001",
      "index": 1,
      "text": "सन्ततिर्गोत्रजननकुलान्यभिजनान्वयौ ॥",
      "audio": "audio/001.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "002",
      "index": 2,
      "text": "वंशोऽन्ववायः सन्तानो वर्णाः स्युर्ब्राह्मणादयः ॥",
      "audio": "audio/002.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "003",
      "index": 3,
      "text": "विप्रक्षत्रियविट्छूद्राश्चातुर्वर्ण्यमिति स्मृतम् ॥",
      "audio": "audio/003.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "004",
      "index": 4,
      "text": "राजबीजी राजवंश्यो बीज्यस्तु कुलसम्भवः ॥",
      "audio": "audio/004.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "005",
      "index": 5,
      "text": "महाकुलकुलीनार्यसभ्यसज्जनसाधवः ॥",
      "audio": "audio/005.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "006",
      "index": 6,
      "text": "ब्रह्मचारी गृही वानप्रस्थो भिक्षुश्चतुष्टये ॥",
      "audio": "audio/006.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "007",
      "index": 7,
      "text": "आश्रमोऽस्त्री द्विजात्यग्रजन्मभूदेववाडवाः ॥",
      "audio": "audio/007.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "008",
      "index": 8,
      "text": "विप्रश्च ब्राह्मणोऽसौ षट्कर्मा यागादिभिर्वृतः ॥",
      "audio": "audio/008.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "009",
      "index": 9,
      "text": "विद्वान् विपश्चिद्दोषज्ञः सन् सुधीः कोविदो बुधः ॥",
      "audio": "audio/009.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "010",
      "index": 10,
      "text": "धीरो मनीषी ज्ञः प्राज्ञः सङ्ख्यावान् पण्डितः कविः ॥",
      "audio": "audio/010.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "011",
      "index": 11,
      "text": "धीमान् सूरिः कृती कृष्टिर्लब्धवर्णो विचक्षणः ॥",
      "audio": "audio/011.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "012",
      "index": 12,
      "text": "दूरदर्शी दीर्घदर्शी श्रोत्रियच्छान्दसौ समौ ॥",
      "audio": "audio/012.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "013",
      "index": 13,
      "text": "मीमांसको जैमिनीये वेदान्ती ब्रह्मवादिनि ॥",
      "audio": "audio/013.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "014",
      "index": 14,
      "text": "वैशेषिके स्यादौलूक्यः सौगतः शून्यवादिनि ॥",
      "audio": "audio/014.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "015",
      "index": 15,
      "text": "नैयायिकस्त्वक्षपादः स्यात् स्याद्वादिक आर्हकः ॥",
      "audio": "audio/015.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "016",
      "index": 16,
      "text": "चार्वाकलौकायतिकौ सत्कार्ये साङ्ख्यकापिलौ ॥",
      "audio": "audio/016.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "017",
      "index": 17,
      "text": "उपाध्यायोऽध्यापकोऽथ स्यान्निषेकादिकृद्गुरुः ॥",
      "audio": "audio/017.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "018",
      "index": 18,
      "text": "मन्त्रव्याख्याकृदाचार्य आदेष्टा त्वध्वरे व्रती ॥",
      "audio": "audio/018.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "019",
      "index": 19,
      "text": "यष्टा च यजमानश्च स सोमवति दीक्षितः ॥",
      "audio": "audio/019.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "020",
      "index": 20,
      "text": "इज्याशीलो यायजूको यज्वा तु विधिनेष्टवान् ॥",
      "audio": "audio/020.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "021",
      "index": 21,
      "text": "स गीष्पतीष्ट्या स्थपतिः सोमपीथी तु सोमपाः ॥",
      "audio": "audio/021.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "022",
      "index": 22,
      "text": "सर्ववेदाः स येनेष्टो यागः सर्वस्वदक्षिणः ॥",
      "audio": "audio/022.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "023",
      "index": 23,
      "text": "अनूचानः प्रवचने साङ्गेऽधीती गुरोस्तु यः ॥",
      "audio": "audio/023.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "024",
      "index": 24,
      "text": "लब्धानुज्ञः समावृत्तः सुत्वा त्वभिषवे कृते ॥",
      "audio": "audio/024.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "025",
      "index": 25,
      "text": "छात्रान्तेवासिनौ शिष्ये शैक्षाः प्राथमकल्पिकाः ॥",
      "audio": "audio/025.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "026",
      "index": 26,
      "text": "एकब्रह्मव्रताचारा मिथः सब्रह्मचारिणः ॥",
      "audio": "audio/026.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "027",
      "index": 27,
      "text": "सतीर्थ्यास्त्वेकगुरवश्चितवानग्निमग्निचित् ॥",
      "audio": "audio/027.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "028",
      "index": 28,
      "text": "पारम्पर्योपदेशे स्यादैतिह्यमितिहाव्ययम् ॥",
      "audio": "audio/028.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "029",
      "index": 29,
      "text": "उपज्ञा ज्ञानमाद्यं स्याज्ज्ञात्वारम्भ उपक्रमः ॥",
      "audio": "audio/029.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "030",
      "index": 30,
      "text": "यज्ञः सवोऽध्वरो यागः सप्ततन्तुर्मखः क्रतुः ॥",
      "audio": "audio/030.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "031",
      "index": 31,
      "text": "पाठो होमश्चातिथीनां सपर्या तर्पणं बलिः ॥",
      "audio": "audio/031.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "032",
      "index": 32,
      "text": "एते पञ्चमहायज्ञा ब्रह्मयज्ञादिनामकाः ॥",
      "audio": "audio/032.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "033",
      "index": 33,
      "text": "समज्या परिषद्गोष्ठी सभासमितिसंसदः ॥",
      "audio": "audio/033.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "034",
      "index": 34,
      "text": "आस्थानी क्लीबमास्थानं स्त्रीनपुंसकयोः सदः ॥",
      "audio": "audio/034.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "035",
      "index": 35,
      "text": "प्राग्वंशः प्राग्घविर्गेहात् सदस्या विधिदर्शिनः ॥",
      "audio": "audio/035.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "036",
      "index": 36,
      "text": "सभासदः सभास्ताराः सभ्याः सामाजिकाश्च ते ॥",
      "audio": "audio/036.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "037",
      "index": 37,
      "text": "अध्वर्यूद्गातृहोतारो यजुःसामर्ग्विदः क्रमात् ॥",
      "audio": "audio/037.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "038",
      "index": 38,
      "text": "आग्नीध्राद्या धनैर्वार्या ऋत्विजो याजकाश्च ते ॥",
      "audio": "audio/038.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "039",
      "index": 39,
      "text": "वेदिः परिष्कृता भूमिः समे स्थण्डिलचत्वरे ॥",
      "audio": "audio/039.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "040",
      "index": 40,
      "text": "चषालो यूपकटकः कुम्बा सुगहना वृतिः ॥",
      "audio": "audio/040.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "041",
      "index": 41,
      "text": "यूपाग्रं तर्म निर्मन्थ्यदारुणि त्वरणिर्द्वयोः ॥",
      "audio": "audio/041.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "042",
      "index": 42,
      "text": "दक्षिणाग्निर्गार्हपत्याहवनीयौ त्रयोऽग्नयः ॥",
      "audio": "audio/042.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "043",
      "index": 43,
      "text": "अग्नित्रयमिदं त्रेता प्रणीतः संस्कृतोऽनलः ॥",
      "audio": "audio/043.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "044",
      "index": 44,
      "text": "समूह्यः परिचाय्योपचाय्यावग्नौ प्रयोगिणः ॥",
      "audio": "audio/044.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "045",
      "index": 45,
      "text": "यो गार्हपत्यादानीय दक्षिणाग्निः प्रणीयते ॥",
      "audio": "audio/045.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "046",
      "index": 46,
      "text": "तस्मिन्नानाय्योऽथाग्नायी स्वाहा च हुतभुक्प्रिया ॥",
      "audio": "audio/046.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "047",
      "index": 47,
      "text": "ऋक्सामिधेनी धाय्या च या स्यादग्निसमिन्धने ॥",
      "audio": "audio/047.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "048",
      "index": 48,
      "text": "गायत्रीप्रमुखं छन्दो हव्यपाके चरुः पुमान् ॥",
      "audio": "audio/048.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "049",
      "index": 49,
      "text": "आमिक्षा सा शृतोष्णे या क्षीरे स्याद्दधियोगतः ॥",
      "audio": "audio/049.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "050",
      "index": 50,
      "text": "धवित्रं व्यजनं तद्यद्रचितं मृगचर्मणा ॥",
      "audio": "audio/050.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "051",
      "index": 51,
      "text": "पृषदाज्यं सदध्याज्ये परमान्नं तु पायसम् ॥",
      "audio": "audio/051.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "052",
      "index": 52,
      "text": "हव्यकव्ये दैवपित्र्ये अन्ने पात्रं स्रुवादिकम् ॥",
      "audio": "audio/052.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "053",
      "index": 53,
      "text": "ध्रुवोपभृज्जुहूर्ना तु स्रुवो भेदाः स्रुचः स्त्रियः ॥",
      "audio": "audio/053.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "054",
      "index": 54,
      "text": "उपाकृतः पशुरसौ योऽभिमन्त्र्य क्रतौ हतः ॥",
      "audio": "audio/054.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "055",
      "index": 55,
      "text": "परम्पराकं शमनं प्रोक्षणं च वधार्थकम् ॥",
      "audio": "audio/055.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "056",
      "index": 56,
      "text": "वाच्यलिङ्गाः प्रमीतोपसम्पन्नप्रोक्षिता हते ॥",
      "audio": "audio/056.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "057",
      "index": 57,
      "text": "सान्नाय्यं हविरग्नौ तु हुतं त्रिषु वषट्कृतम् ॥",
      "audio": "audio/057.wav",
