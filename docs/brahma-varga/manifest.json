      "meta": {},
      "error": null
    },
    {
      "id": "116",
      "index": 116,
      "text": "सन्न्यासवत्यनशने पुमान् प्रायोऽथ वीरहा ॥",
      "audio": "audio/116.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "117",
      "index": 117,
      "text": "नष्टाग्निः कुहना लोभान्मिथ्येर्यापथकल्पना ॥",
      "audio": "audio/117.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "118",
      "index": 118,
      "text": "व्रात्यः संस्कारहीनः स्यादस्वाध्यायो निराकृतिः ॥",
      "audio": "audio/118.wav",
      "meter": "anuṣṭubh",
      "source_ref": null,
      "annotations": [],
      "meta": {},
      "error": null
    },
    {
      "id": "119",
      "index": 119,
      "text": "धर्मध्वजी लिङ्गवृत्तिरवकीर्णी क्षतव्रतः ॥",
      "audio": "audio/119.wav",
